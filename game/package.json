{
  "name": "corebreaker",
  "version": "1.0.0",
  "description": "COREBREAKER — futuristisches Pixel-Art Mining-Game (iOS & Android, Portrait)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:generate": "capacitor-assets generate --android --ios --iconBackgroundColor '#0a0713' --iconBackgroundColorDark '#0a0713' --splashBackgroundColor '#0a0713' --splashBackgroundColorDark '#0a0713'",
    "cap:sync": "npm run build && cap sync",
    "ios:add": "cap add ios",
    "ios:open": "npm run cap:sync && cap open ios",
    "android:add": "cap add android",
    "android:open": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
